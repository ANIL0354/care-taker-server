@baseUrl = http://localhost:8080
@caretakerEmail = rahul@example.com
@caretakerPassword = Password@123
@token = {{login.response.body.token}}
@date = {{$datetime iso8601 1}}
@pickupSlotId = 10
@returnSlotId = 16

### Signup
# @name signup
POST {{baseUrl}}/api/auth/signup
Content-Type: application/json

{
  "name": "Rahul Verma",
  "email": "{{caretakerEmail}}",
  "phone": "9876543210",
  "password": "{{caretakerPassword}}"
}

### Login
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{caretakerEmail}}",
  "password": "{{caretakerPassword}}"
}

### List hospitals
GET {{baseUrl}}/api/hospitals
Authorization: Bearer {{token}}

### List available slots (replace date with yyyy-MM-dd)
GET {{baseUrl}}/api/slots?date=2026-11-25
Authorization: Bearer {{token}}

### One-way booking
POST {{baseUrl}}/api/bookings
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "hospitalId": 1,
  "patientName": "Asha Verma",
  "patientPhone": "9876543211",
  "homeAddress": "12 Main Street, Bengaluru",
  "mobilityNeed": "WALKING",
  "notes": "",
  "rides": [
    {"direction": "HOME_TO_HOSPITAL", "slotId": {{pickupSlotId}}}
  ]
}

### Round-trip booking
POST {{baseUrl}}/api/bookings
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "hospitalId": 1,
  "patientName": "Asha Verma",
  "patientPhone": "9876543211",
  "homeAddress": "12 Main Street, Bengaluru",
  "mobilityNeed": "WHEELCHAIR",
  "notes": "Need wheelchair",
  "rides": [
    {"direction": "HOME_TO_HOSPITAL", "slotId": {{pickupSlotId}}},
    {"direction": "HOSPITAL_TO_HOME", "slotId": {{returnSlotId}}}
  ]
}
